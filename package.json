{
  "name": "mod-portal-snake-classic",
  "version": "1.0.0",
  "private": true,
  "description": "Portal de documentación para autores de mods de Snake Classic. Vitepress + Storybook + catálogo machine-readable. Scaffold W2 del roadmap mods-workshop-ecosystem.",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o dist/storybook",
    "build:all": "pnpm build && pnpm build:storybook",
    "validate": "node scripts/validate-catalog.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.5.0",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
